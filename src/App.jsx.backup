/* =========================================================
   APPLICATION PRINCIPALE
========================================================= */

function App() {
  const [data, setData] = useState(loadData);

  const [page, setPage] = useState("home");

  const [authMode, setAuthMode] = useState(null);
  const [authRole, setAuthRole] = useState("youth");

  const [currentUser, setCurrentUser] = useState(null);

  const [adminSession, setAdminSession] = useState(null);

  const [cart, setCart] = useState([]);

  const [message, setMessage] = useState("");

  useEffect(() => {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
  }, [data]);

  useEffect(() => {
    if (!message) return undefined;

    const timer = setTimeout(() => {
      setMessage("");
    }, 4000);

    return () => clearTimeout(timer);
  }, [message]);

  const userOrders = useMemo(() => {
    if (!currentUser) return [];

    return data.orders.filter(
      (order) => order.userId === currentUser.id
    );
  }, [data.orders, currentUser]);

  const cartTotal = useMemo(() => {
    return cart.reduce(
      (total, item) => total + item.price * item.quantity,
      0
    );
  }, [cart]);

  function notify(text) {
    setMessage(text);
  }

  function updateData(updater) {
    setData((previous) => {
      if (typeof updater === "function") {
        return updater(previous);
      }

      return updater;
    });
  }

  function addActivity(action, details = "") {
    const entry = {
      id: safeRandomId(),
      action,
      details,
      admin: adminSession?.matricule || currentUser?.matricule || "SYSTEM",
      date: new Date().toISOString(),
    };

    updateData((previous) => ({
      ...previous,
      activityLog: [entry, ...previous.activityLog].slice(0, 500),
    }));
  }

  /* =======================================================
     AUTHENTIFICATION UTILISATEURS
  ======================================================= */

  function registerUser(form) {
    const email = normalize(form.email);

    const existing = data.users.find(
      (user) => normalize(user.email) === email
    );

    if (existing) {
      notify("Cette adresse e-mail possède déjà un compte.");
      return;
    }

    const number =
      form.role === "youth"
        ? data.counters.youth
        : data.counters.responsible;

    const matricule = generateMatricule({
      gender: form.gender,
      lastName: form.lastName,
      nationality: form.nationality,
      birthOrRegistrationMonth: form.registrationMonth,
      number,
    });

    const newUser = {
      id: safeRandomId(),
      matricule,
      role: form.role,

      firstName: form.firstName,
      lastName: form.lastName,

      email: form.email,
      phone: form.phone,

      gender: form.gender,
      nationality: form.nationality,
      registrationMonth: form.registrationMonth,

      birthDate: "",
      church: "",
      maritalStatus: "",
      baptized: "",

      photo: "",
      cv: "",

      deliveryAddress: "",

      createdAt: new Date().toISOString(),

      /*
        Aucun mot de passe n'est stocké ici.
        Cette version locale utilise une authentification
        temporaire côté navigateur.
      */
    };

    updateData((previous) => ({
      ...previous,

      users: [...previous.users, newUser],

      counters: {
        ...previous.counters,

        ...(form.role === "youth"
          ? {
              youth: previous.counters.youth + 1,
            }
          : {
              responsible: previous.counters.responsible + 1,
            }),
      },
    }));

    setCurrentUser(newUser);
    setAuthMode(null);
    setPage("dashboard");

    notify(
      `Compte créé. Votre matricule est ${matricule}.`
    );
  }

  function loginUser(form) {
    /*
      Dans cette maquette locale, le compte utilisateur
      est retrouvé avec l'e-mail et le rôle.

      Le vrai mot de passe devra être contrôlé par le backend
      en production.
    */

    const user = data.users.find(
      (item) =>
        normalize(item.email) === normalize(form.email) &&
        item.role === form.role
    );

    if (!user) {
      notify(
        "Compte introuvable. Vérifiez l'adresse e-mail et l'espace choisi."
      );
      return;
    }

    setCurrentUser(user);
    setAuthMode(null);
    setPage("dashboard");

    notify(`Bienvenue ${user.firstName}.`);
  }

  function logout() {
    setCurrentUser(null);
    setAdminSession(null);
    setCart([]);
    setPage("home");

    notify("Vous êtes déconnecté.");
  }

  function updateProfile(updates) {
    if (!currentUser) return;

    const updatedUser = {
      ...currentUser,
      ...updates,
    };

    updateData((previous) => ({
      ...previous,
      users: previous.users.map((user) =>
        user.id === currentUser.id ? updatedUser : user
      ),
    }));

    setCurrentUser(updatedUser);

    notify("Votre profil a été enregistré.");
  }

  /* =======================================================
     REQUÊTES
  ======================================================= */

  function addRequest(subject, description) {
    if (!currentUser) return;

    const number = data.counters.request;

    const request = {
      id: safeRandomId(),
      reference: makeReference("REQ", number),

      userId: currentUser.id,
      matricule: currentUser.matricule,

      subject,
      description,

      status: "En attente",

      createdAt: new Date().toISOString(),
    };

    updateData((previous) => ({
      ...previous,

      requests: [...previous.requests, request],

      counters: {
        ...previous.counters,
        request: previous.counters.request + 1,
      },
    }));

    notify("Votre requête a été envoyée.");
  }

  /* =======================================================
     PROJETS
  ======================================================= */

  function addProject(title, description) {
    if (!currentUser) return;

    const number = data.counters.project;

    const project = {
      id: safeRandomId(),
      reference: makeReference("PRO", number),

      userId: currentUser.id,
      matricule: currentUser.matricule,

      title,
      description,

      status: "Soumis",

      createdAt: new Date().toISOString(),
    };

    updateData((previous) => ({
      ...previous,

      projects: [...previous.projects, project],

      counters: {
        ...previous.counters,
        project: previous.counters.project + 1,
      },
    }));

    notify("Votre projet a été soumis.");
  }

  /* =======================================================
     ÉGLISES
  ======================================================= */

  function addChurch(form) {
    if (!currentUser) return;

    const number = data.counters.church;

    const church = {
      id: safeRandomId(),

      reference: makeReference("EGL", number),

      name: form.name,
      city: form.city,
      location: form.location,

      pastor: form.pastor,
      pastorPhone: form.pastorPhone,

      submittedBy: currentUser.matricule,

      status: "En attente",

      createdAt: new Date().toISOString(),
    };

    updateData((previous) => ({
      ...previous,

      churches: [...previous.churches, church],

      counters: {
        ...previous.counters,
        church: previous.counters.church + 1,
      },
    }));

    notify("L'église a été soumise pour validation.");
  }

  function validateChurch(churchId) {
    updateData((previous) => ({
      ...previous,

      churches: previous.churches.map((church) =>
        church.id === churchId
          ? {
              ...church,
              status: "Validée",
              validatedAt: new Date().toISOString(),
            }
          : church
      ),
    }));

    addActivity("Validation église", churchId);

    notify("Église validée.");
  }

  function rejectChurch(churchId) {
    updateData((previous) => ({
      ...previous,

      churches: previous.churches.map((church) =>
        church.id === churchId
          ? {
              ...church,
              status: "Rejetée",
              rejectedAt: new Date().toISOString(),
            }
          : church
      ),
    }));

    addActivity("Rejet église", churchId);

    notify("Église rejetée.");
  }

  /* =======================================================
     PANIER
  ======================================================= */

  function addToCart(product, size = "") {
    if (!product.stock) {
      notify("Ce produit est actuellement en rupture de stock.");
      return;
    }

    setCart((previous) => {
      const existing = previous.find(
        (item) =>
          item.id === product.id &&
          item.size === size
      );

      if (existing) {
        return previous.map((item) =>
          item.id === product.id &&
          item.size === size
            ? {
                ...item,
                quantity: Math.min(
                  item.quantity + 1,
                  product.stock
                ),
              }
            : item
        );
      }

      return [
        ...previous,
        {
          ...product,
          quantity: 1,
          size,
        },
      ];
    });

    notify("Article ajouté au panier.");
  }

  function removeFromCart(productId, size = "") {
    setCart((previous) =>
      previous.filter(
        (item) =>
          !(
            item.id === productId &&
            item.size === size
          )
      )
    );
  }

  function updateCartQuantity(productId, size, quantity) {
    setCart((previous) =>
      previous.map((item) =>
        item.id === productId &&
        item.size === size
          ? {
              ...item,
              quantity: Math.max(
                1,
                Math.min(
                  Number(quantity),
                  item.stock
                )
              ),
            }
          : item
      )
    );
  }

  /* =======================================================
     COMMANDES
  ======================================================= */

  function createOrder() {
    if (!currentUser) {
      notify("Connectez-vous pour passer une commande.");

      setAuthRole("youth");
      setAuthMode("login");
      setPage("auth");

      return;
    }

    if (!cart.length) {
      notify("Votre panier est vide.");
      return;
    }

    const number = data.counters.order;

    const order = {
      id: safeRandomId(),

      reference: makeReference("CMD", number),

      userId: currentUser.id,
      matricule: currentUser.matricule,

      customer: {
        firstName: currentUser.firstName,
        lastName: currentUser.lastName,
        email: currentUser.email,
        phone: currentUser.phone,
      },

      deliveryAddress: currentUser.deliveryAddress || "",

      items: cart.map((item) => ({
        productId: item.id,
        name: item.name,
        price: item.price,
        quantity: item.quantity,
        size: item.size || "",
      })),

      total: cartTotal,

      status: "En attente de paiement",

      paymentStatus: "En attente",

      receiptCode: null,

      createdAt: new Date().toISOString(),
    };

    updateData((previous) => ({
      ...previous,

      orders: [...previous.orders, order],

      products: previous.products.map((product) => {
        const quantity = cart
          .filter((item) => item.id === product.id)
          .reduce(
            (sum, item) => sum + item.quantity,
            0
          );

        return quantity
          ? {
              ...product,
              stock: Math.max(
                0,
                product.stock - quantity
              ),
            }
          : product;
      }),

      counters: {
        ...previous.counters,
        order: previous.counters.order + 1,
      },
    }));

    setCart([]);

    setPage("dashboard");

    notify(
      `Commande ${order.reference} créée.`
    );
  }

  /* =======================================================
     PAIEMENT
  ======================================================= */

  function payOrder(orderId) {
    const order = data.orders.find(
      (item) => item.id === orderId
    );

    if (!order) {
      notify("Commande introuvable.");
      return;
    }

    if (order.paymentStatus === "Payé") {
      notify("Cette commande est déjà payée.");
      return;
    }

    const receiptNumber = data.counters.receipt;

    const receiptCode = generateReceiptCode(
      receiptNumber
    );

    const payment = {
      id: safeRandomId(),

      orderId: order.id,

      reference: order.reference,

      userId: order.userId,

      matricule: order.matricule,

      amount: order.total,

      method: "Paiement de démonstration",

      status: "Payé",

      receiptCode,

      createdAt: new Date().toISOString(),
    };

    updateData((previous) => ({
      ...previous,

      orders: previous.orders.map((item) =>
        item.id === orderId
          ? {
              ...item,
              status: "Payée",
              paymentStatus: "Payé",
              receiptCode,
              paidAt: new Date().toISOString(),
            }
          : item
      ),

      payments: [
        ...previous.payments,
        payment,
      ],

      counters: {
        ...previous.counters,
        receipt: previous.counters.receipt + 1,
      },
    }));

    notify(
      `Paiement confirmé. Reçu ${receiptCode} disponible.`
    );
  }

  /* =======================================================
     REÇU
  ======================================================= */

  function printReceipt(order) {
    if (!order || order.paymentStatus !== "Payé") {
      notify(
        "Le reçu est disponible uniquement après paiement."
      );
      return;
    }

    const receiptWindow = window.open(
      "",
      "_blank",
      "width=900,height=900"
    );

    if (!receiptWindow) {
      notify(
        "Le navigateur a bloqué la fenêtre du reçu."
      );
      return;
    }

    const customerName = `${order.customer?.firstName || ""} ${
      order.customer?.lastName || ""
    }`.trim();

    const rows = order.items
      .map(
        (item) => `
          <tr>
            <td>${escapeHtml(item.name)}</td>
            <td>${item.quantity}</td>
            <td>${escapeHtml(item.size || "-")}</td>
            <td>${money(item.price)}</td>
            <td>${money(item.price * item.quantity)}</td>
          </tr>
        `
      )
      .join("");

    receiptWindow.document.write(`
      <!doctype html>
      <html lang="fr">
        <head>
          <meta charset="UTF-8" />
          <title>Reçu ${escapeHtml(order.receiptCode)}</title>

          <style>
            @page {
              size: A4;
              margin: 12mm;
            }

            * {
              box-sizing: border-box;
            }

            body {
              margin: 0;
              font-family: Arial, Helvetica, sans-serif;
              background: #f3f6fb;
              color: #172033;
            }

            .receipt {
              width: 100%;
              max-width: 794px;
              margin: 0 auto;
              background: white;
              padding: 38px;
              border-top: 10px solid #155eef;
              min-height: 100vh;
            }

            .head {
              display: flex;
              justify-content: space-between;
              gap: 30px;
              align-items: flex-start;
              border-bottom: 1px solid #dfe5ef;
              padding-bottom: 25px;
            }

            .brand {
              font-size: 34px;
              font-weight: 900;
              letter-spacing: -1px;
              color: #155eef;
            }

            .brand span {
              color: #f5c400;
            }

            .receipt-title {
              text-align: right;
            }

            .receipt-title h1 {
              margin: 0;
              font-size: 25px;
            }

            .code {
              margin-top: 8px;
              font-weight: 800;
              color: #6633cc;
            }

            .info {
              display: grid;
              grid-template-columns: 1fr 1fr;
              gap: 18px;
              margin: 28px 0;
            }

            .box {
              padding: 18px;
              background: #f7f9fc;
              border-radius: 12px;
            }

            .label {
              display: block;
              color: #718096;
              font-size: 12px;
              margin-bottom: 5px;
            }

            table {
              width: 100%;
              border-collapse: collapse;
              margin-top: 20px;
            }

            th,
            td {
              padding: 12px 8px;
              border-bottom: 1px solid #e4e8ef;
              text-align: left;
            }

            th {
              font-size: 12px;
              text-transform: uppercase;
              color: #657083;
            }

            .total {
              margin-top: 25px;
              margin-left: auto;
              max-width: 300px;
              padding: 20px;
              background: #155eef;
              color: white;
              border-radius: 14px;
            }

            .total strong {
              display: block;
              font-size: 26px;
              margin-top: 6px;
            }

            .paid {
              margin-top: 25px;
              padding: 14px;
              background: #e7f8ef;
              color: #16784a;
              border-radius: 10px;
              font-weight: 800;
            }

            .footer {
              margin-top: 45px;
              padding-top: 18px;
              border-top: 1px solid #e1e5eb;
              font-size: 11px;
              color: #778196;
              text-align: center;
            }

            @media print {
              body {
                background: white;
              }

              .receipt {
                max-width: none;
                min-height: auto;
              }
            }
          </style>
        </head>

        <body>
          <div class="receipt">

            <div class="head">
              <div>
                <div class="brand">
                  JAD<span>CI</span>
                </div>

                <div>
                  Reçu officiel de paiement
                </div>
              </div>

              <div class="receipt-title">
                <h1>REÇU</h1>

                <div class="code">
                  ${escapeHtml(order.receiptCode)}
                </div>
              </div>
            </div>

            <div class="info">

              <div class="box">
                <span class="label">
                  CLIENT
                </span>

                <strong>
                  ${escapeHtml(customerName)}
                </strong>

                <br />

                Matricule :
                ${escapeHtml(order.matricule)}

                <br />

                ${escapeHtml(order.customer?.email || "")}

                <br />

                ${escapeHtml(order.customer?.phone || "")}
              </div>

              <div class="box">
                <span class="label">
                  COMMANDE
                </span>

                Référence :
                <strong>
                  ${escapeHtml(order.reference)}
                </strong>

                <br />

                Date :
                ${escapeHtml(formatDate(order.createdAt))}

                <br />

                Paiement :
                <strong>Payé</strong>
              </div>

            </div>

            <table>
              <thead>
                <tr>
                  <th>Produit</th>
                  <th>Qté</th>
                  <th>Taille</th>
                  <th>Prix</th>
                  <th>Total</th>
                </tr>
              </thead>

              <tbody>
                ${rows}
              </tbody>
            </table>

            <div class="total">
              TOTAL PAYÉ
              <strong>${money(order.total)}</strong>
            </div>

            <div class="paid">
              ✓ Paiement enregistré
              <br />
              Code unique :
              ${escapeHtml(order.receiptCode)}
            </div>

            <div class="footer">
              JADCI — Plateforme de gestion et de services.
              <br />
              Ce document constitue le reçu de la commande
              ${escapeHtml(order.reference)}.
            </div>

          </div>

          <script>
            window.onload = function () {
              window.print();
            };
          </script>
        </body>
      </html>
    `);

    receiptWindow.document.close();
  }

  /* =======================================================
     CANDIDATURES
  ======================================================= */

  function addApplication(title, messageText) {
    if (!currentUser) return;

    const number = data.counters.application;

    const application = {
      id: safeRandomId(),
      reference: makeReference("CAN", number),
      userId: currentUser.id,
      matricule: currentUser.matricule,
      title,
      message: messageText,
      status: "En traitement",
      createdAt: new Date().toISOString(),
    };

    updateData((previous) => ({
      ...previous,

      applications: [
        ...previous.applications,
        application,
      ],

      counters: {
        ...previous.counters,
        application:
          previous.counters.application + 1,
      },
    }));

    notify("Votre candidature a été transmise.");
  }

  /* =======================================================
     RECOMMANDATIONS
  ======================================================= */

  function addRecommendation(title, text) {
    if (!currentUser) return;

    const number = data.counters.recommendation;

    const recommendation = {
      id: safeRandomId(),
      reference: makeReference("REC", number),
      userId: currentUser.id,
      matricule: currentUser.matricule,
      title,
      text,
      status: "En attente",
      createdAt: new Date().toISOString(),
    };

    updateData((previous) => ({
      ...previous,

      recommendations: [
        ...previous.recommendations,
        recommendation,
      ],

      counters: {
        ...previous.counters,
        recommendation:
          previous.counters.recommendation + 1,
      },
    }));

    notify("Votre recommandation a été transmise.");
  }

  /* =======================================================
     RAPPORTS
  ======================================================= */

  function addReport(title, text) {
    if (!currentUser) return;

    const number = data.counters.report;

    const report = {
      id: safeRandomId(),
      reference: makeReference("RAP", number),
      userId: currentUser.id,
      matricule: currentUser.matricule,
      title,
      text,
      status: "Transmis",
      createdAt: new Date().toISOString(),
    };

    updateData((previous) => ({
      ...previous,

      reports: [...previous.reports, report],

      counters: {
        ...previous.counters,
        report: previous.counters.report + 1,
      },
    }));

    notify("Votre rapport a été transmis.");
  }

  /* =======================================================
     EXPORTS
  ======================================================= */

  function exportExcel(type) {
    let rows = [];

    if (type === "users") {
      rows = [
        [
          "Matricule",
          "Nom",
          "Prénom",
          "Rôle",
          "Genre",
          "Nationalité",
          "Email",
          "Téléphone",
          "Église",
          "Baptême",
          "Situation matrimoniale",
          "Date inscription",
        ],
        ...data.users.map((user) => [
          user.matricule,
          user.lastName,
          user.firstName,
          user.role === "youth"
            ? "Jeune"
            : "Responsable",
          user.gender,
          user.nationality,
          user.email,
          user.phone,
          user.church,
          user.baptized,
          user.maritalStatus,
          formatDate(user.createdAt),
        ]),
      ];
    }

    if (type === "requests") {
      rows = [
        [
          "Référence",
          "Matricule",
          "Objet",
          "Description",
          "Statut",
          "Date",
        ],
        ...data.requests.map((item) => [
          item.reference,
          item.matricule,
          item.subject,
          item.description,
          item.status,
          formatDate(item.createdAt),
        ]),
      ];
    }

    if (type === "projects") {
      rows = [
        [
          "Référence",
          "Matricule",
          "Titre",
          "Description",
          "Statut",
          "Date",
        ],
        ...data.projects.map((item) => [
          item.reference,
          item.matricule,
          item.title,
          item.description,
          item.status,
          formatDate(item.createdAt),
        ]),
      ];
    }

    if (type === "churches") {
      rows = [
        [
          "Référence",
          "Église",
          "Ville",
          "Localisation",
          "Pasteur",
          "Téléphone",
          "Soumise par",
          "Statut",
          "Date",
        ],
        ...data.churches.map((item) => [
          item.reference,
          item.name,
          item.city,
          item.location,
          item.pastor,
          item.pastorPhone,
          item.submittedBy,
          item.status,
          formatDate(item.createdAt),
        ]),
      ];
    }

    if (type === "orders") {
      rows = [
        [
          "Commande",
          "Matricule",
          "Montant",
          "Statut",
          "Paiement",
          "Code reçu",
          "Date",
        ],
        ...data.orders.map((item) => [
          item.reference,
          item.matricule,
          item.total,
          item.status,
          item.paymentStatus,
          item.receiptCode || "",
          formatDate(item.createdAt),
        ]),
      ];
    }

    if (type === "payments") {
      rows = [
        [
          "Commande",
          "Matricule",
          "Montant",
          "Méthode",
          "Statut",
          "Code reçu",
          "Date",
        ],
        ...data.payments.map((item) => [
          item.reference,
          item.matricule,
          item.amount,
          item.method,
          item.status,
          item.receiptCode,
          formatDate(item.createdAt),
        ]),
      ];
    }

    if (type === "applications") {
      rows = [
        [
          "Référence",
          "Matricule",
          "Titre",
          "Message",
          "Statut",
          "Date",
        ],
        ...data.applications.map((item) => [
          item.reference,
          item.matricule,
          item.title,
          item.message,
          item.status,
          formatDate(item.createdAt),
        ]),
      ];
    }

    if (type === "recommendations") {
      rows = [
        [
          "Référence",
          "Matricule",
          "Titre",
          "Texte",
          "Statut",
          "Date",
        ],
        ...data.recommendations.map((item) => [
          item.reference,
          item.matricule,
          item.title,
          item.text,
          item.status,
          formatDate(item.createdAt),
        ]),
      ];
    }

    if (type === "reports") {
      rows = [
        [
          "Référence",
          "Matricule",
          "Titre",
          "Rapport",
          "Statut",
          "Date",
        ],
        ...data.reports.map((item) => [
          item.reference,
          item.matricule,
          item.title,
          item.text,
          item.status,
          formatDate(item.createdAt),
        ]),
      ];
    }

    if (!rows.length) {
      notify("Aucune donnée à exporter.");
      return;
    }

    const csv = rows
      .map((row) =>
        row
          .map(
            (value) =>
              `"${String(value ?? "").replaceAll(
                '"',
                '""'
              )}"`
          )
          .join(";")
      )
      .join("\n");

    const blob = new Blob(["\ufeff" + csv], {
      type: "text/csv;charset=utf-8;",
    });

    const url = URL.createObjectURL(blob);

    const link = document.createElement("a");

    link.href = url;
    link.download = `JADCI-${type}-${Date.now()}.csv`;

    document.body.appendChild(link);
    link.click();
    link.remove();

    URL.revokeObjectURL(url);

    notify(
      "Export terminé. Le fichier CSV peut être ouvert avec Excel."
    );
  }

  /* =======================================================
     ADMINISTRATION
  ======================================================= */

  function loginAdmin(form) {
    const account = Object.entries(
      ADMIN_ACCOUNTS
    ).find(
      ([, item]) =>
        item.matricule === form.matricule &&
        item.password === form.password
    );

    if (!account) {
      notify("Identifiants administrateur incorrects.");
      return;
    }

    const [role, accountData] = account;

    setAdminSession({
      role,
      matricule: accountData.matricule,
      label: accountData.label,
    });

    setPage("admin");

    notify(`Bienvenue dans le portail ${accountData.label}.`);
  }

  function adminLogout() {
    setAdminSession(null);
    setPage("home");
    notify("Session administrateur fermée.");
  }

  function deleteProduct(productId) {
    if (!adminSession) return;

    updateData((previous) => ({
      ...previous,

      products: previous.products.filter(
        (product) => product.id !== productId
      ),
    }));

    addActivity("Suppression produit", productId);

    notify("Produit supprimé.");
  }

  function updateProduct(productId, updates) {
    if (!adminSession) return;

    updateData((previous) => ({
      ...previous,

      products: previous.products.map((product) =>
        product.id === productId
          ? {
              ...product,
              ...updates,
            }
          : product
      ),
    }));

    addActivity("Modification produit", productId);

    notify("Produit modifié.");
  }

  function addProduct(product) {
    if (!adminSession) return;

    const newProduct = {
      id: safeRandomId(),
      name: product.name,
      price: Number(product.price) || 0,
      stock: Number(product.stock) || 0,
      category: product.category,
      description: product.description,
      image: product.image || "",
      sizes: product.sizes || [],
    };

    updateData((previous) => ({
      ...previous,
      products: [
        ...previous.products,
        newProduct,
      ],
    }));

    addActivity("Ajout produit", newProduct.name);

    notify("Produit ajouté.");
  }

  function deleteNews(newsId) {
    if (!adminSession) return;

    updateData((previous) => ({
      ...previous,

      news: previous.news.filter(
        (item) => item.id !== newsId
      ),
    }));

    addActivity("Suppression actualité", newsId);

    notify("Publication supprimée.");
  }

  function addNews(form) {
    if (!adminSession) return;

    const item = {
      id: safeRandomId(),
      title: form.title,
      text: form.text,
      type: form.type || "actualite",
      image: form.image || "",
      video: form.video || "",
      document: form.document || "",
      date: new Date().toLocaleDateString("fr-FR"),
      published: true,
    };

    updateData((previous) => ({
      ...previous,

      news: [item, ...previous.news],
    }));

    addActivity("Publication actualité", item.title);

    notify("Publication créée.");
  }

  /* =======================================================
     RENDU
  ======================================================= */

  return (
    <div className="jadci-app">

      <header className="topbar">

        <button
          className="logo"
          type="button"
          onClick={() => setPage("home")}
        >
          JADCI
        </button>

        <nav>

          <button
            type="button"
            onClick={() => setPage("home")}
          >
            Accueil
          </button>

          <button
            type="button"
            onClick={() => setPage("news")}
          >
            Actualités
          </button>

          <button
            type="button"
            onClick={() => setPage("media")}
          >
            Médiat
          </button>

          <button
            type="button"
            onClick={() => setPage("churches")}
          >
            Églises
          </button>

          <button
            type="button"
            onClick={() => setPage("shop")}
          >
            Boutique
          </button>

          {!currentUser && !adminSession && (
            <>
              <button
                type="button"
                onClick={() => {
                  setAuthRole("youth");
                  setAuthMode("login");
                  setPage("auth");
                }}
              >
                Espace Jeunes
              </button>

              <button
                type="button"
                onClick={() => {
                  setAuthRole("responsible");
                  setAuthMode("login");
                  setPage("auth");
                }}
              >
                Espace Responsables
              </button>
            </>
          )}

          {currentUser && (
            <>
              <button
                type="button"
                onClick={() => setPage("dashboard")}
              >
                Mon espace
              </button>

              <button
                type="button"
                onClick={logout}
              >
                Déconnexion
              </button>
            </>
          )}

          {!adminSession && (
            <button
              type="button"
              onClick={() => setPage("adminLogin")}
            >
              Portail
            </button>
          )}

          {adminSession && (
            <>
              <button
                type="button"
                onClick={() => setPage("admin")}
              >
                Administration
              </button>

              <button
                type="button"
                onClick={adminLogout}
              >
                Quitter admin
              </button>
            </>
          )}

        </nav>
      </header>

      {message && (
        <div className="toast">
          {message}
        </div>
      )}

      <main>

        {page === "home" && (
          <Home
            news={data.news}
            onYouth={() => {
              setAuthRole("youth");
              setAuthMode("register");
              setPage("auth");
            }}
            onResponsible={() => {
              setAuthRole("responsible");
              setAuthMode("register");
              setPage("auth");
            }}
            onShop={() => setPage("shop")}
            onNews={() => setPage("news")}
          />
        )}

        {page === "news" && (
          <NewsPage news={data.news} />
        )}

        {page === "media" && (
          <MediaPage />
        )}

        {page === "churches" && (
          <ChurchDirectory
            churches={data.churches}
          />
        )}

        {page === "auth" && (
          <AuthPage
            mode={authMode || "login"}
            role={authRole}
            setMode={setAuthMode}
            setRole={setAuthRole}
            onRegister={registerUser}
            onLogin={loginUser}
          />
        )}

        {page === "dashboard" && currentUser && (
          <Dashboard
            user={currentUser}
            data={data}
            orders={userOrders}
            onUpdateProfile={updateProfile}
            onRequest={addRequest}
            onProject={addProject}
            onChurch={addChurch}
            onPayment={payOrder}
            onReceipt={printReceipt}
            onApplication={addApplication}
            onRecommendation={addRecommendation}
            onReport={addReport}
            onShop={() => setPage("shop")}
          />
        )}

        {page === "shop" && (
          <Shop
            products={data.products}
            cart={cart}
            total={cartTotal}
            onAdd={addToCart}
            onRemove={removeFromCart}
            onQuantity={updateCartQuantity}
            onOrder={createOrder}
            onLogin={() => {
              setAuthRole(
                currentUser?.role || "youth"
              );

              setAuthMode("login");
              setPage("auth");
            }}
            connected={Boolean(currentUser)}
          />
        )}

        {page === "adminLogin" && (
          <AdminLogin
            onLogin={loginAdmin}
            onBack={() => setPage("home")}
          />
        )}

        {page === "admin" && adminSession && (
          <AdminPortal
            session={adminSession}
            data={data}
            onValidateChurch={validateChurch}
            onRejectChurch={rejectChurch}
            onDeleteProduct={deleteProduct}
            onAddProduct={addProduct}
            onUpdateProduct={updateProduct}
            onDeleteNews={deleteNews}
            onAddNews={addNews}
            onExport={exportExcel}
          />
        )}

      </main>

      <footer>

        <strong>JADCI</strong>

        <span>
          Plateforme de gestion, d'information,
          de services et de développement.
        </span>

      </footer>

    </div>
  );
}

/* =========================================================
   ACCUEIL
========================================================= */

function Home({
  onYouth,
  onResponsible,
  onShop,
  onNews,
}) {
  return (
    <section className="home">

      <div className="announcement-bar">
        <div className="announcement-track">
          ✦ JADCI · Jeunesse · Engagement · Développement ·
          Communauté · Actualités · Boutique · Services ·
          ✦ JADCI · Ensemble pour construire l'avenir
        </div>
      </div>

      <div className="hero">

        <div className="hero-content">

          <span className="eyebrow">
            JADCI · PLATEFORME OFFICIELLE
          </span>

          <h1>
            Jeunesse.
            <br />
            Engagement.
            <br />
            <span>Impact.</span>
          </h1>

          <p>
            Une plateforme moderne pour connecter
            les jeunes, les responsables, les églises
            et les services JADCI.
          </p>

          <div className="hero-actions">

            <button
              className="primary"
              type="button"
              onClick={onYouth}
            >
              🟨 Espace Jeunes
            </button>

            <button
              className="green"
              type="button"
              onClick={onResponsible}
            >
              🟩 Espace Responsables
            </button>

            <button
              type="button"
              onClick={onShop}
            >
              🛒 Boutique
            </button>

          </div>

        </div>

        <div className="hero-orbit">
          <div className="hero-orbit-inner">
            JADCI
          </div>
        </div>

      </div>

      <section className="cards-section">

        <div className="info-card yellow">

          <span>01</span>

          <h2>
            Espace Jeunes
          </h2>

          <p>
            Votre bureau personnel pour gérer
            votre profil, vos requêtes, vos projets,
            vos commandes et vos informations.
          </p>

          <button
            type="button"
            onClick={onYouth}
          >
            Accéder à mon espace →
          </button>

        </div>

        <div className="info-card green">

          <span>02</span>

          <h2>
            Espace Responsables
          </h2>

          <p>
            Gérez vos activités, projets,
            recommandations, rapports,
            convocations et églises.
          </p>

          <button
            type="button"
            onClick={onResponsible}
          >
            Accéder à mon espace →
          </button>

        </div>

        <div className="info-card violet">

          <span>03</span>

          <h2>
            Actualités
          </h2>

          <p>
            Retrouvez les annonces, publications,
            informations et contenus JADCI.
          </p>

          <button
            type="button"
            onClick={onNews}
          >
            Découvrir →
          </button>

        </div>

      </section>
    </section>
  );
}

/* =========================================================
   AUTH
========================================================= */

function AuthPage({
  mode,
  role,
  setMode,
  setRole,
  onRegister,
  onLogin,
}) {
  const [form, setForm] = useState({
    firstName: "",
    lastName: "",
    email: "",
    phone: "",
    gender: "Homme",
    nationality: "Ivoirienne",
    registrationMonth:
      new Date().getMonth() + 1,
  });

  const isRegister = mode === "register";

  function update(field, value) {
    setForm((previous) => ({
      ...previous,
      [field]: value,
    }));
  }

  function submit(event) {
    event.preventDefault();

    if (isRegister) {
      if (
        !form.firstName ||
        !form.lastName ||
        !form.email
      ) {
        return;
      }

      onRegister({
        ...form,
        role,
      });

      return;
    }

    onLogin({
      email: form.email,
      role,
    });
  }

  return (
    <section className="auth-page">

      <div className="auth-card">

        <div className="role-switch">

          <button
            type="button"
            className={
              role === "youth"
                ? "selected yellow-bg"
                : ""
            }
            onClick={() => setRole("youth")}
          >
            🟨 Jeunes
          </button>

          <button
            type="button"
            className={
              role === "responsible"
                ? "selected green-bg"
                : ""
            }
            onClick={() =>
              setRole("responsible")
            }
          >
            🟩 Responsables
          </button>

        </div>

        <span className="eyebrow">
          {role === "youth"
            ? "ESPACE JEUNES"
            : "ESPACE RESPONSABLES"}
        </span>

        <h1>
          {isRegister
            ? "Créer votre espace"
            : "Retrouver votre espace"}
        </h1>

        <p className="muted">
          Un compte correspond à un seul espace
          personnel.
        </p>

        <form onSubmit={submit}>

          {isRegister && (
            <>
              <label>
                Prénom
                <input
                  value={form.firstName}
                  onChange={(event) =>
                    update(
                      "firstName",
                      event.target.value
                    )
                  }
                  required
                />
              </label>

              <label>
                Nom
                <input
                  value={form.lastName}
                  onChange={(event) =>
                    update(
                      "lastName",
                      event.target.value
                    )
                  }
                  required
                />
              </label>

              <label>
                Genre
                <select
                  value={form.gender}
                  onChange={(event) =>
                    update(
                      "gender",
                      event.target.value
                    )
                  }
                >
                  <option>Homme</option>
                  <option>Femme</option>
                </select>
              </label>

              <label>
                Nationalité
                <select
                  value={form.nationality}
                  onChange={(event) =>
                    update(
                      "nationality",
                      event.target.value
                    )
                  }
                >
                  <option>Ivoirienne</option>
                  <option>Autre</option>
                </select>
              </label>

              <label>
                Mois d'inscription
                <select
                  value={form.registrationMonth}
                  onChange={(event) =>
                    update(
                      "registrationMonth",
                      event.target.value
                    )
                  }
                >
                  {Array.from(
                    { length: 12 },
                    (_, index) => (
                      <option
                        key={index + 1}
                        value={index + 1}
                      >
                        {index + 1}
                      </option>
                    )
                  )}
                </select>
              </label>

              <label>
                Téléphone
                <input
                  value={form.phone}
                  onChange={(event) =>
                    update(
                      "phone",
                      event.target.value
                    )
                  }
                />
              </label>
            </>
          )}

          <label>
            Adresse e-mail
            <input
              type="email"
              value={form.email}
              onChange={(event) =>
                update(
                  "email",
                  event.target.value
                )
              }
              required
            />
          </label>

          <button
            className="primary full"
            type="submit"
          >
            {isRegister
              ? "Créer mon espace"
              : "Accéder à mon espace"}
          </button>

        </form>

        <div className="auth-links">

          {isRegister ? (
            <button
              type="button"
              onClick={() =>
                setMode("login")
              }
            >
              J'ai déjà un compte
            </button>
          ) : (
            <button
              type="button"
              onClick={() =>
                setMode("register")
              }
            >
              Créer un compte
            </button>
          )}

        </div>

      </div>
    </section>
  );
}

/* =========================================================
   DASHBOARD
========================================================= */

function Dashboard({
  user,
  data,
  orders,
  onUpdateProfile,
  onRequest,
  onProject,
  onChurch,
  onPayment,
  onReceipt,
  onApplication,
  onRecommendation,
  onReport,
  onShop,
}) {
  const [tab, setTab] =
    useState("overview");

  const userRequests =
    data.requests.filter(
      (item) => item.userId === user.id
    );

  const userProjects =
    data.projects.filter(
      (item) => item.userId === user.id
    );

  const userApplications =
    data.applications.filter(
      (item) => item.userId === user.id
    );

  const userRecommendations =
    data.recommendations.filter(
      (item) => item.userId === user.id
    );

  const userReports =
    data.reports.filter(
      (item) => item.userId === user.id
    );

  return (
    <section className="dashboard">

      <div className="dashboard-head">

        <div>

          <span className="eyebrow">
            {user.role === "youth"
              ? "ESPACE · JEUNES"
              : "ESPACE · RESPONSABLES"}
          </span>

          <h1>
            Bonjour {user.firstName} 👋
          </h1>

          <p>
            Matricule :
            <strong>
              {" "}
              {user.matricule}
            </strong>
          </p>

        </div>

        <div className="avatar">

          {user.photo ? (
            <img
              src={user.photo}
              alt="Profil"
            />
          ) : (
            user.firstName?.charAt(0)
          )}

        </div>

      </div>

      <div className="dashboard-grid">

        <aside className="side-menu">

          <button
            className={
              tab === "overview"
                ? "active"
                : ""
            }
            onClick={() =>
              setTab("overview")
            }
          >
            🏠 Mon bureau
          </button>

          <button
            className={
              tab === "profile"
                ? "active"
                : ""
            }
            onClick={() =>
              setTab("profile")
            }
          >
            👤 Mon profil
          </button>

          <button
            className={
              tab === "requests"
                ? "active"
                : ""
            }
            onClick={() =>
              setTab("requests")
            }
          >
            📝 Mes requêtes
          </button>

          <button
            className={
              tab === "projects"
                ? "active"
                : ""
            }
            onClick={() =>
              setTab("projects")
            }
          >
            💡 Mes projets
          </button>

          <button
            className={
              tab === "orders"
                ? "active"
                : ""
            }
            onClick={() =>
              setTab("orders")
            }
          >
            🛒 Mes commandes
          </button>

          {user.role === "responsible" && (
            <>
              <button
                className={
                  tab === "church"
                    ? "active"
                    : ""
                }
                onClick={() =>
                  setTab("church")
                }
              >
                ⛪ Enregistrer une église
              </button>

              <button
                className={
                  tab === "applications"
                    ? "active"
                    : ""
                }
                onClick={() =>
                  setTab("applications")
                }
              >
                📄 Candidature
              </button>

              <button
                className={
                  tab === "recommendations"
                    ? "active"
                    : ""
                }
                onClick={() =>
                  setTab("recommendations")
                }
              >
                ⭐ Recommandations
              </button>

              <button
                className={
                  tab === "reports"
                    ? "active"
                    : ""
                }
                onClick={() =>
                  setTab("reports")
                }
              >
                📊 Rapports
              </button>
            </>
          )}

        </aside>

        <div className="dashboard-content">

          {tab === "overview" && (
            <DashboardOverview
              user={user}
              data={data}
              orders={orders}
              onShop={onShop}
            />
          )}

          {tab === "profile" && (
            <ProfileForm
              user={user}
              onSave={onUpdateProfile}
            />
          )}

          {tab === "requests" && (
            <RequestForm
              requests={userRequests}
              onSubmit={onRequest}
            />
          )}

          {tab === "projects" && (
            <ProjectForm
              projects={userProjects}
              onSubmit={onProject}
            />
          )}

          {tab === "orders" && (
            <Orders
              orders={orders}
              onPayment={onPayment}
              onReceipt={onReceipt}
            />
          )}

          {tab === "church" &&
            user.role === "responsible" && (
              <ChurchForm
                churches={data.churches.filter(
                  (church) =>
                    church.submittedBy ===
                    user.matricule
                )}
                onSubmit={onChurch}
              />
            )}

          {tab === "applications" &&
            user.role === "responsible" && (
              <ApplicationForm
                applications={
                  userApplications
                }
                onSubmit={onApplication}
              />
            )}

          {tab === "recommendations" &&
            user.role === "responsible" && (
              <RecommendationForm
                recommendations={
                  userRecommendations
                }
                onSubmit={
                  onRecommendation
                }
              />
            )}

          {tab === "reports" &&
            user.role === "responsible" && (
              <ReportForm
                reports={userReports}
                onSubmit={onReport}
              />
            )}

        </div>

      </div>
    </section>
  );
}

/* =========================================================
   OVERVIEW
========================================================= */

function DashboardOverview({
  user,
  data,
  orders,
  onShop,
}) {
  const requests =
    data.requests.filter(
      (item) => item.userId === user.id
    );

  const projects =
    data.projects.filter(
      (item) => item.userId === user.id
    );

  const paidOrders =
    orders.filter(
      (item) =>
        item.paymentStatus === "Payé"
    );

  return (
    <div>

      <span className="eyebrow">
        VOTRE BUREAU
      </span>

      <h2>
        Votre espace personnel
      </h2>

      <p className="muted">
        Retrouvez ici les informations,
        activités et services qui vous concernent.
      </p>

      <div className="stats">

        <div>
          <strong>
            {requests.length}
          </strong>
          <span>
            Requêtes
          </span>
        </div>

        <div>
          <strong>
            {projects.length}
          </strong>
          <span>
            Projets
          </span>
        </div>

        <div>
          <strong>
            {orders.length}
          </strong>
          <span>
            Commandes
          </span>
        </div>

        <div>
          <strong>
            {paidOrders.length}
          </strong>
          <span>
            Paiements
          </span>
        </div>

      </div>

      <div className="notice">

        <strong>
          📢 Informations JADCI
        </strong>

        <p>
          Consultez régulièrement les actualités
          et les informations qui vous concernent.
        </p>

      </div>

      <button
        className="primary"
        onClick={onShop}
      >
        🛒 Accéder à la boutique
      </button>

    </div>
  );
}

/* =========================================================
   PROFIL
========================================================= */

function ProfileForm({
  user,
  onSave,
}) {
  const [form, setForm] =
    useState({
      firstName:
        user.firstName || "",
      lastName:
        user.lastName || "",
      phone:
        user.phone || "",
      birthDate:
        user.birthDate || "",
      church:
        user.church || "",
      maritalStatus:
        user.maritalStatus || "",
      baptized:
        user.baptized || "",
      photo:
        user.photo || "",
      cv:
        user.cv || "",
      deliveryAddress:
        user.deliveryAddress || "",
    });

  function update(field, value) {
    setForm((previous) => ({
      ...previous,
      [field]: value,
    }));
  }

  return (
    <div>

      <span className="eyebrow">
        PROFIL
      </span>

      <h2>
        Mes informations
      </h2>

      <div className="profile-badge">
        Matricule :
        <strong>
          {" "}
          {user.matricule}
        </strong>
      </div>

      <div className="form-grid">

        <label>
          Prénom
          <input
            value={form.firstName}
            onChange={(e) =>
              update(
                "firstName",
                e.target.value
              )
            }
          />
        </label>

        <label>
          Nom
          <input
            value={form.lastName}
            onChange={(e) =>
              update(
                "lastName",
                e.target.value
              )
            }
          />
        </label>

        <label>
          E-mail
          <input
            value={user.email}
            disabled
          />
        </label>

        <label>
          Téléphone
          <input
            value={form.phone}
            onChange={(e) =>
              update(
                "phone",
                e.target.value
              )
            }
          />
        </label>

        <label>
          Date de naissance
          <input
            type="date"
            value={form.birthDate}
            onChange={(e) =>
              update(
                "birthDate",
                e.target.value
              )
            }
          />
        </label>

        <label>
          Église
          <input
            value={form.church}
            onChange={(e) =>
              update(
                "church",
                e.target.value
              )
            }
          />
        </label>

        <label>
          Situation matrimoniale
          <select
            value={
              form.maritalStatus
            }
            onChange={(e) =>
              update(
                "maritalStatus",
                e.target.value
              )
            }
          >
            <option value="">
              Choisir
            </option>
            <option>
              Célibataire
            </option>
            <option>
              Marié(e)
            </option>
            <option>
              Concubinage
            </option>
          </select>
        </label>

        <label>
          Baptême d'eau
          <select
            value={form.baptized}
            onChange={(e) =>
              update(
                "baptized",
                e.target.value
              )
            }
          >
            <option value="">
              Choisir
            </option>
            <option>
              Oui
            </option>
            <option>
              Non
            </option>
          </select>
        </label>

        <label className="wide">
          Photo de profil
          <input
            placeholder="URL de la photo"
            value={form.photo}
            onChange={(e) =>
              update(
                "photo",
                e.target.value
              )
            }
          />
        </label>

        <label className="wide">
          Lieu de livraison
          <textarea
            placeholder="Adresse ou lieu de livraison"
            value={
              form.deliveryAddress
            }
            onChange={(e) =>
              update(
                "deliveryAddress",
                e.target.value
              )
            }
          />
        </label>

        <label className="wide">
          CV
          <textarea
            placeholder="Informations ou lien vers votre CV"
            value={form.cv}
            onChange={(e) =>
              update(
                "cv",
                e.target.value
              )
            }
          />
        </label>

      </div>

      <button
        className="primary"
        onClick={() => onSave(form)}
      >
        Enregistrer mon profil
      </button>

    </div>
  );
}

/* =========================================================
   REQUÊTES
========================================================= */

function RequestForm({
  requests,
  onSubmit,
}) {
  const [subject, setSubject] =
    useState("");

  const [description, setDescription] =
    useState("");

  function submit(event) {
    event.preventDefault();

    if (!subject || !description) {
      return;
    }

    onSubmit(
      subject,
      description
    );

    setSubject("");
    setDescription("");
  }

  return (
    <div>

      <span className="eyebrow">
        REQUÊTES
      </span>

      <h2>
        Mes requêtes
      </h2>

      <form
        onSubmit={submit}
        className="simple-form"
      >

        <label>
          Objet
          <input
            value={subject}
            onChange={(e) =>
              setSubject(
                e.target.value
              )
            }
            required
          />
        </label>

        <label>
          Requête
          <textarea
            value={description}
            onChange={(e) =>
              setDescription(
                e.target.value
              )
            }
            required
          />
        </label>

        <button className="primary">
          Envoyer la requête
        </button>

      </form>

      <div className="list">

        {requests.map((item) => (
          <div
            className="list-item"
            key={item.id}
          >
            <strong>
              {item.reference}
            </strong>

            <span>
              {item.subject}
            </span>

            <small>
              {item.status}
            </small>
          </div>
        ))}

        {!requests.length && (
          <p className="muted">
            Aucune requête pour le moment.
          </p>
        )}

      </div>

    </div>
  );
}

