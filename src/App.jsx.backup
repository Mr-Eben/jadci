/* =========================================================
   OUTILS
========================================================= */

function safeRandomId() {
  if (typeof crypto !== "undefined" && crypto.randomUUID) {
    return crypto.randomUUID();
  }

  return `${Date.now()}-${Math.random().toString(36).slice(2)}`;
}

function money(value) {
  return (
    new Intl.NumberFormat("fr-FR", {
      maximumFractionDigits: 0,
    }).format(Number(value || 0)) + " FCFA"
  );
}

function formatDate(value) {
  if (!value) return "";

  try {
    return new Date(value).toLocaleString("fr-FR");
  } catch {
    return value;
  }
}

function makeReference(prefix, number) {
  return `${prefix}-${String(number).padStart(6, "0")}`;
}

function normalize(value) {
  return String(value || "")
    .trim()
    .toLowerCase();
}

function generateReceiptCode(number) {
  return `JAD-${new Date().getFullYear()}-${String(number).padStart(
    6,
    "0"
  )}`;
}

/*
  Format demandé :

  [Genre][Initial][Mois][Nationalité][K+année][NNNN]

  Exemple :
  FA11K260001

  F = Femme
  A = première lettre du nom
  1 = janvier
  1 = ivoirienne
  K26 = année 2026
  0001 = numéro d'ordre
*/

function generateMatricule({
  gender,
  lastName,
  nationality,
  birthOrRegistrationMonth,
  number,
}) {
  const genderCode =
    normalize(gender) === "femme" ||
    normalize(gender) === "f"
      ? "F"
      : "H";

  const initial =
    String(lastName || "X")
      .trim()
      .charAt(0)
      .toUpperCase() || "X";

  const month = String(
    Number(birthOrRegistrationMonth) || new Date().getMonth() + 1
  ).padStart(2, "0");

  const nationalityCode =
    normalize(nationality) === "ivoirienne" ||
    normalize(nationality) === "ivoirien" ||
    normalize(nationality) === "ci"
      ? "1"
      : "2";

  const year = String(new Date().getFullYear()).slice(-2);

  const order = String(number).padStart(4, "0");

  return `${genderCode}${initial}${month}${nationalityCode}K${year}${order}`;
}

function loadData() {
  try {
    const saved = localStorage.getItem(STORAGE_KEY);

    if (!saved) {
      return defaultData;
    }

    const parsed = JSON.parse(saved);

    return {
      ...defaultData,
      ...parsed,
      users: parsed.users || [],
      requests: parsed.requests || [],
      projects: parsed.projects || [],
      churches: parsed.churches || [],
      applications: parsed.applications || [],
      recommendations: parsed.recommendations || [],
      reports: parsed.reports || [],
      convocations: parsed.convocations || [],
      orders: parsed.orders || [],
      payments: parsed.payments || [],
      products:
        parsed.products && parsed.products.length
          ? parsed.products
          : initialProducts,
      news:
        parsed.news && parsed.news.length
          ? parsed.news
          : initialNews,
      announcements: parsed.announcements || [],
      activityLog: parsed.activityLog || [],
      counters: {
        ...defaultData.counters,
        ...(parsed.counters || {}),
      },
    };
  } catch {
    return defaultData;
  }
}

