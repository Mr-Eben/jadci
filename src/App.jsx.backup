/* =========================================================
   ANNUAIRE ÉGLISES
========================================================= */

function ChurchDirectory({
  churches,
}) {
  const validated =
    churches.filter(
      (church) =>
        church.status === "Validée"
    );

  return (
    <section className="church-directory">

      <span className="eyebrow">
        ANNUAIRE
      </span>

      <h1>
        Églises JADCI
      </h1>

      <p className="muted">
        Les églises apparaissent ici après
        validation par l'administration.
      </p>

      <div className="map-placeholder">
        🗺️
        <strong>
          Carte interactive
        </strong>
        <span>
          Le module cartographique réel
          pourra être connecté à une API
          de cartographie dans la version
          serveur.
        </span>
      </div>

      <div className="church-grid">

        {validated.map((church) => (
          <article
            className="church-card"
            key={church.id}
          >

            <span>
              ⛪
            </span>

            <h2>
              {church.name}
            </h2>

            <p>
              {church.city}
            </p>

            {church.location && (
              <small>
                {church.location}
              </small>
            )}

            {church.pastor && (
              <small>
                Pasteur : {church.pastor}
              </small>
            )}

          </article>
        ))}

      </div>

      {!validated.length && (
        <p className="muted">
          Aucune église validée pour le moment.
        </p>
      )}

    </section>
  );
}

/* =========================================================
   LOGIN ADMIN
========================================================= */

function AdminLogin({
  onLogin,
  onBack,
}) {
  const [matricule, setMatricule] =
    useState("");

  const [password, setPassword] =
    useState("");

  function submit(event) {
    event.preventDefault();

    onLogin({
      matricule,
      password,
    });
  }

  return (
    <section className="admin-login">

      <div className="admin-login-card">

        <span className="eyebrow">
          PORTAIL PRIVÉ
        </span>

        <h1>
          Administration JADCI
        </h1>

        <p className="muted">
          Accès réservé aux administrateurs
          autorisés.
        </p>

        <form onSubmit={submit}>

          <label>
            Matricule
            <input
              value={matricule}
              onChange={(e) =>
                setMatricule(
                  e.target.value
                )
              }
              autoComplete="username"
              required
            />
          </label>

          <label>
            Mot de passe
            <input
              type="password"
              value={password}
              onChange={(e) =>
                setPassword(
                  e.target.value
                )
              }
              autoComplete="current-password"
              required
            />
          </label>

          <button
            className="primary full"
            type="submit"
          >
            Ouvrir le portail
          </button>

        </form>

        <button
          type="button"
          onClick={onBack}
        >
          ← Retour au site
        </button>

      </div>

    </section>
  );
}

/* =========================================================
   PORTAIL ADMIN
========================================================= */

function AdminPortal({
  session,
  data,
  onValidateChurch,
  onRejectChurch,
  onDeleteProduct,
  onAddProduct,
  onUpdateProduct,
  onDeleteNews,
  onAddNews,
  onExport,
}) {
  const [section, setSection] =
    useState("dashboard");

  const isGeneral =
    session.role === "general";

  const isMarketing =
    session.role === "marketing";

  const isCommunication =
    session.role === "communication";

  return (
    <section className="admin-portal">

      <div className="admin-header">

        <div>

          <span className="eyebrow">
            JADCI · ADMINISTRATION
          </span>

          <h1>
            {session.label}
          </h1>

          <p>
            Session :
            {" "}
            <strong>
              {session.matricule}
            </strong>
          </p>

        </div>

        <div className="admin-status">
          ● SYSTÈME ACTIF
        </div>

      </div>

      <div className="admin-layout">

        <aside className="admin-menu">

          <button
            className={
              section === "dashboard"
                ? "active"
                : ""
            }
            onClick={() =>
              setSection("dashboard")
            }
          >
            ◈ Tableau de bord
          </button>

          {isGeneral && (
            <>
              <button
                className={
                  section === "users"
                    ? "active"
                    : ""
                }
                onClick={() =>
                  setSection("users")
                }
              >
                👥 Utilisateurs
              </button>

              <button
                className={
                  section === "churches"
                    ? "active"
                    : ""
                }
                onClick={() =>
                  setSection("churches")
                }
              >
                ⛪ Églises
              </button>

              <button
                className={
                  section === "reports"
                    ? "active"
                    : ""
                }
                onClick={() =>
                  setSection("reports")
                }
              >
                📊 Rapports
              </button>

              <button
                className={
                  section === "exports"
                    ? "active"
                    : ""
                }
                onClick={() =>
                  setSection("exports")
                }
              >
                📥 Exports
              </button>
            </>
          )}

          {(isGeneral ||
            isMarketing) && (
            <button
              className={
                section === "shop"
                  ? "active"
                  : ""
              }
              onClick={() =>
                setSection("shop")
              }
            >
              🛒 Boutique
            </button>
          )}

          {(isGeneral ||
            isCommunication) && (
            <button
              className={
                section === "news"
                  ? "active"
                  : ""
              }
              onClick={() =>
                setSection("news")
              }
            >
              📢 Communication
            </button>
          )}

          <button
            className={
              section === "activity"
                ? "active"
                : ""
            }
            onClick={() =>
              setSection("activity")
            }
          >
            🛡️ Journal
          </button>

        </aside>

        <div className="admin-content">

          {section === "dashboard" && (
            <AdminDashboard
              data={data}
              session={session}
            />
          )}

          {section === "users" &&
            isGeneral && (
              <AdminUsers
                users={data.users}
              />
            )}

          {section === "churches" &&
            isGeneral && (
              <AdminChurches
                churches={data.churches}
                onValidate={
                  onValidateChurch
                }
                onReject={
                  onRejectChurch
                }
              />
            )}

          {section === "reports" &&
            isGeneral && (
              <AdminReports
                data={data}
              />
            )}

          {section === "exports" &&
            isGeneral && (
              <AdminExports
                onExport={onExport}
              />
            )}

          {section === "shop" &&
            (isGeneral ||
              isMarketing) && (
              <AdminShop
                data={data}
                onDelete={
                  onDeleteProduct
                }
                onAdd={onAddProduct}
                onUpdate={
                  onUpdateProduct
                }
              />
            )}

          {section === "news" &&
            (isGeneral ||
              isCommunication) && (
              <AdminNews
                data={data}
                onDelete={
                  onDeleteNews
                }
                onAdd={onAddNews}
              />
            )}

          {section === "activity" && (
            <AdminActivity
              activity={data.activityLog}
            />
          )}

        </div>

      </div>

    </section>
  );
}

/* =========================================================
   ADMIN DASHBOARD
========================================================= */

function AdminDashboard({
  data,
  session,
}) {
  const revenue =
    data.payments
      .filter(
        (payment) =>
          payment.status === "Payé"
      )
      .reduce(
        (sum, payment) =>
          sum + Number(payment.amount || 0),
        0
      );

  const pendingRequests =
    data.requests.filter(
      (item) =>
        item.status === "En attente"
    ).length;

  const pendingChurches =
    data.churches.filter(
      (item) =>
        item.status === "En attente"
    ).length;

  const today =
    new Date().toDateString();

  const ordersToday =
    data.orders.filter(
      (order) =>
        new Date(
          order.createdAt
        ).toDateString() === today
    ).length;

  return (
    <div className="admin-dashboard">

      <div className="admin-welcome">

        <span className="eyebrow">
          CONSOLE
        </span>

        <h2>
          Centre de contrôle
        </h2>

        <p>
          Vue générale du portail JADCI.
        </p>

      </div>

      <div className="admin-stats">

        <AdminMetric
          label="Utilisateurs"
          value={data.users.length}
          icon="👥"
        />

        <AdminMetric
          label="Requêtes"
          value={pendingRequests}
          icon="📝"
        />

        <AdminMetric
          label="Projets"
          value={data.projects.length}
          icon="💡"
        />

        <AdminMetric
          label="Églises en attente"
          value={pendingChurches}
          icon="⛪"
        />

        <AdminMetric
          label="Commandes du jour"
          value={ordersToday}
          icon="🛒"
        />

        <AdminMetric
          label="Paiements"
          value={data.payments.length}
          icon="💳"
        />

        <AdminMetric
          label="Candidatures"
          value={data.applications.length}
          icon="📄"
        />

        <AdminMetric
          label="Annonces"
          value={data.news.length}
          icon="📢"
        />

      </div>

      {session.role === "general" && (
        <div className="revenue-card">

          <span>
            CHIFFRE D'AFFAIRES
          </span>

          <strong>
            {money(revenue)}
          </strong>

          <small>
            Paiements enregistrés
            sur les commandes boutique.
          </small>

        </div>
      )}

      <div className="admin-panels">

        <div className="admin-panel">

          <h3>
            État du système
          </h3>

          <div className="system-row">
            <span>
              Base locale
            </span>
            <strong>
              ● Active
            </strong>
          </div>

          <div className="system-row">
            <span>
              Paiements
            </span>
            <strong>
              ● Actifs
            </strong>
          </div>

          <div className="system-row">
            <span>
              Boutique
            </span>
            <strong>
              ● Active
            </strong>
          </div>

          <div className="system-row">
            <span>
              Sécurité
            </span>
            <strong>
              ● Session protégée
            </strong>
          </div>

        </div>

        <div className="admin-panel">

          <h3>
            Modules
          </h3>

          <div className="module-grid">

            <span>
              Utilisateurs
            </span>

            <span>
              Boutique
            </span>

            <span>
              Paiements
            </span>

            <span>
              Actualités
            </span>

            <span>
              Églises
            </span>

            <span>
              Projets
            </span>

          </div>

        </div>

      </div>

    </div>
  );
}

function AdminMetric({
  label,
  value,
  icon,
}) {
  return (
    <div className="admin-metric">

      <span>
        {icon}
      </span>

      <strong>
        {value}
      </strong>

      <small>
        {label}
      </small>

    </div>
  );
}

/* =========================================================
   ADMIN USERS
