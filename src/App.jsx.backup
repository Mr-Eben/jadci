/* =========================================================
   ADMIN EXPORTS
========================================================= */

function AdminExports({
  onExport,
}) {
  const exportsList = [
    ["users", "👥 Utilisateurs"],
    ["churches", "⛪ Églises"],
    ["requests", "📝 Requêtes"],
    ["projects", "💡 Projets"],
    ["orders", "🛒 Commandes"],
    ["payments", "💳 Paiements"],
    ["applications", "📄 Candidatures"],
    ["recommendations", "⭐ Recommandations"],
    ["reports", "📊 Rapports"],
  ];

  return (
    <div>

      <span className="eyebrow">
        DONNÉES
      </span>

      <h2>
        Exports administratifs
      </h2>

      <p className="muted">
        Téléchargez les données pour
        les exploiter dans Excel.
      </p>

      <div className="export-grid">

        {exportsList.map(
          ([type, label]) => (
            <button
              key={type}
              onClick={() =>
                onExport(type)
              }
            >
              📥 {label}
            </button>
          )
        )}

      </div>

    </div>
  );
}

/* =========================================================
   ADMIN BOUTIQUE
========================================================= */

function AdminShop({
  data,
  onDelete,
  onAdd,
  onUpdate,
}) {
  const [form, setForm] =
    useState({
      name: "",
      price: "",
      stock: "",
      category: "Vêtement",
      description: "",
      image: "",
    });

  function update(field, value) {
    setForm((previous) => ({
      ...previous,
      [field]: value,
    }));
  }

  function submit(event) {
    event.preventDefault();

    if (!form.name) return;

    onAdd(form);

    setForm({
      name: "",
      price: "",
      stock: "",
      category: "Vêtement",
      description: "",
      image: "",
    });
  }

  return (
    <div>

      <span className="eyebrow">
        MARKETING
      </span>

      <h2>
        Gestion de la boutique
      </h2>

      <form
        className="simple-form admin-product-form"
        onSubmit={submit}
      >

        <h3>
          Ajouter un produit
        </h3>

        <label>
          Nom
          <input
            value={form.name}
            onChange={(e) =>
              update(
                "name",
                e.target.value
              )
            }
            required
          />
        </label>

        <label>
          Prix
          <input
            type="number"
            value={form.price}
            onChange={(e) =>
              update(
                "price",
                e.target.value
              )
            }
            required
          />
        </label>

        <label>
          Stock
          <input
            type="number"
            value={form.stock}
            onChange={(e) =>
              update(
                "stock",
                e.target.value
              )
            }
            required
          />
        </label>

        <label>
          Catégorie
          <select
            value={form.category}
            onChange={(e) =>
              update(
                "category",
                e.target.value
              )
            }
          >
            <option>
              Vêtement
            </option>
            <option>
              Accessoire
            </option>
            <option>
              Livre
            </option>
            <option>
              Papeterie
            </option>
            <option>
              Autre
            </option>
          </select>
        </label>

        <label>
          Image
          <input
            placeholder="URL de l'image"
            value={form.image}
            onChange={(e) =>
              update(
                "image",
                e.target.value
              )
            }
          />
        </label>

        <label>
          Description
          <textarea
            value={form.description}
            onChange={(e) =>
              update(
                "description",
                e.target.value
              )
            }
          />
        </label>

        <button className="primary">
          Ajouter le produit
        </button>

      </form>

      <div className="admin-section">

        <h3>
          Produits
        </h3>

        {data.products.map(
          (product) => (
            <div
              className="admin-row"
              key={product.id}
            >

              <div>

                <strong>
                  {product.name}
                </strong>

                <span>
                  {money(product.price)}
                  {" · "}
                  Stock : {product.stock}
                </span>

              </div>

              <div>

                <button
                  onClick={() =>
                    onUpdate(
                      product.id,
                      {
                        stock:
                          Number(
                            product.stock
                          ) + 1,
                      }
                    )
                  }
                >
                  + Stock
                </button>

                <button
                  className="danger"
                  onClick={() =>
                    onDelete(
                      product.id
                    )
                  }
                >
                  Supprimer
                </button>

              </div>

            </div>
          )
        )}

      </div>

      <div className="admin-section">

        <h3>
          Commandes
        </h3>

        {data.orders.map(
          (order) => (
            <div
              className="admin-row"
              key={order.id}
            >

              <div>
                <strong>
                  {order.reference}
                </strong>

                <span>
                  {order.matricule}
                  {" · "}
                  {money(order.total)}
                </span>
              </div>

              <span>
                {order.paymentStatus}
              </span>

            </div>
          )
        )}

        {!data.orders.length && (
          <p className="muted">
            Aucune commande.
          </p>
        )}

      </div>

    </div>
  );
}

/* =========================================================
   ADMIN COMMUNICATION
========================================================= */

function AdminNews({
  data,
  onDelete,
  onAdd,
}) {
  const [form, setForm] =
    useState({
      title: "",
      text: "",
      image: "",
      video: "",
      document: "",
      type: "actualite",
    });

  function update(field, value) {
    setForm((previous) => ({
      ...previous,
      [field]: value,
    }));
  }

  function submit(event) {
    event.preventDefault();

    if (!form.title || !form.text) {
      return;
    }

    onAdd(form);

    setForm({
      title: "",
      text: "",
      image: "",
      video: "",
      document: "",
      type: "actualite",
    });
  }

  return (
    <div>

      <span className="eyebrow">
        COMMUNICATION
      </span>

      <h2>
        Actualités et annonces
      </h2>

      <form
        className="simple-form"
        onSubmit={submit}
      >

        <h3>
          Nouvelle publication
        </h3>

        <label>
          Titre
          <input
            value={form.title}
            onChange={(e) =>
              update(
                "title",
                e.target.value
              )
            }
            required
          />
        </label>

        <label>
          Texte
          <textarea
            value={form.text}
            onChange={(e) =>
              update(
                "text",
                e.target.value
              )
            }
            required
          />
        </label>

        <label>
          Image
          <input
            placeholder="URL image"
            value={form.image}
            onChange={(e) =>
              update(
                "image",
                e.target.value
              )
            }
          />
        </label>

        <label>
          Vidéo
          <input
            placeholder="Lien vidéo"
            value={form.video}
            onChange={(e) =>
              update(
                "video",
                e.target.value
              )
            }
          />
        </label>

        <label>
          Document
          <input
            placeholder="Lien document"
            value={form.document}
            onChange={(e) =>
              update(
                "document",
                e.target.value
              )
            }
          />
        </label>

        <button className="primary">
          Publier
        </button>

      </form>

      <div className="admin-section">

        <h3>
          Publications
        </h3>

        {data.news.map((item) => (
          <div
            className="admin-row"
            key={item.id}
          >

            <div>

              <strong>
                {item.title}
              </strong>

              <span>
                {item.date}
              </span>

            </div>

            <button
              className="danger"
              onClick={() =>
                onDelete(item.id)
              }
            >
              Supprimer
            </button>

          </div>
        ))}

      </div>

    </div>
  );
}

/* =========================================================
   JOURNAL ADMIN
========================================================= */

function AdminActivity({
  activity,
}) {
  return (
    <div>

      <span className="eyebrow">
        SÉCURITÉ
      </span>

      <h2>
        Journal des actions
      </h2>

      <div className="list">

        {activity.map((item) => (
          <div
            className="list-item"
            key={item.id}
          >

            <strong>
              {item.action}
            </strong>

            <span>
              {item.details}
            </span>

            <small>
              {item.admin}
              {" · "}
              {formatDate(
                item.date
              )}
            </small>

          </div>
        ))}

        {!activity.length && (
          <p className="muted">
            Aucune activité enregistrée.
          </p>
        )}

      </div>

    </div>
  );
}

/* =========================================================
   SÉCURITÉ HTML POUR LE REÇU
========================================================= */

function escapeHtml(value) {
  return String(value ?? "")
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");
}

export default App;