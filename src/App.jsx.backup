/* =========================================================
   ÉGLISE
========================================================= */

function ChurchForm({
  churches,
  onSubmit,
}) {
  const [form, setForm] =
    useState({
      name: "",
      city: "",
      location: "",
      pastor: "",
      pastorPhone: "",
    });

  function update(field, value) {
    setForm((previous) => ({
      ...previous,
      [field]: value,
    }));
  }

  function submit(event) {
    event.preventDefault();

    if (
      !form.name ||
      !form.city
    ) {
      return;
    }

    onSubmit(form);

    setForm({
      name: "",
      city: "",
      location: "",
      pastor: "",
      pastorPhone: "",
    });
  }

  return (
    <div>

      <span className="eyebrow">
        ÉGLISE
      </span>

      <h2>
        Enregistrer une église
      </h2>

      <p className="muted">
        L'église sera examinée par
        l'administration avant d'apparaître
        dans l'annuaire officiel.
      </p>

      <form
        onSubmit={submit}
        className="simple-form"
      >

        <label>
          Nom de l'église
          <input
            value={form.name}
            onChange={(e) =>
              update(
                "name",
                e.target.value
              )
            }
            required
          />
        </label>

        <label>
          Ville
          <input
            value={form.city}
            onChange={(e) =>
              update(
                "city",
                e.target.value
              )
            }
            required
          />
        </label>

        <label>
          Localisation
          <input
            value={form.location}
            onChange={(e) =>
              update(
                "location",
                e.target.value
              )
            }
          />
        </label>

        <label>
          Nom du pasteur
          <input
            value={form.pastor}
            onChange={(e) =>
              update(
                "pastor",
                e.target.value
              )
            }
          />
        </label>

        <label>
          Téléphone du pasteur
          <input
            value={form.pastorPhone}
            onChange={(e) =>
              update(
                "pastorPhone",
                e.target.value
              )
            }
          />
        </label>

        <button className="green">
          Soumettre l'église
        </button>

      </form>

      <div className="list">

        {churches.map((church) => (
          <div
            className="list-item"
            key={church.id}
          >
            <strong>
              {church.reference}
            </strong>

            <span>
              {church.name}
              {" · "}
              {church.city}
            </span>

            <small>
              {church.status}
            </small>
          </div>
        ))}

      </div>

    </div>
  );
}

/* =========================================================
   COMMANDES
========================================================= */

function Orders({
  orders,
  onPayment,
  onReceipt,
}) {
  return (
    <div>

      <span className="eyebrow">
        BOUTIQUE
      </span>

      <h2>
        Mes commandes
      </h2>

      {!orders.length && (
        <p className="muted">
          Vous n'avez pas encore de commande.
        </p>
      )}

      <div className="order-list">

        {orders.map((order) => (
          <article
            className="order-card"
            key={order.id}
          >

            <div>

              <strong>
                {order.reference}
              </strong>

              <span>
                {money(order.total)}
              </span>

            </div>

            <p>
              Statut :
              {" "}
              <strong>
                {order.status}
              </strong>
            </p>

            <p>
              Paiement :
              {" "}
              <strong>
                {order.paymentStatus}
              </strong>
            </p>

            {order.paymentStatus !==
              "Payé" && (
              <button
                className="primary"
                onClick={() =>
                  onPayment(
                    order.id
                  )
                }
              >
                💳 Payer la commande
              </button>
            )}

            {order.receiptCode && (
              <div className="receipt">

                🧾 Reçu :
                {" "}
                <strong>
                  {order.receiptCode}
                </strong>

                <br />

                <button
                  className="green"
                  onClick={() =>
                    onReceipt(order)
                  }
                >
                  📄 Télécharger / imprimer le reçu
                </button>

              </div>
            )}

          </article>
        ))}

      </div>

    </div>
  );
}

/* =========================================================
   CANDIDATURE
========================================================= */

function ApplicationForm({
  applications,
  onSubmit,
}) {
  const [title, setTitle] =
    useState("");

  const [messageText, setMessageText] =
    useState("");

  function submit(event) {
    event.preventDefault();

    if (!title || !messageText) {
      return;
    }

    onSubmit(
      title,
      messageText
    );

    setTitle("");
    setMessageText("");
  }

  return (
    <div>

      <span className="eyebrow">
        CANDIDATURE
      </span>

      <h2>
        Soumettre une candidature
      </h2>

      <form
        className="simple-form"
        onSubmit={submit}
      >

        <label>
          Intitulé
          <input
            value={title}
            onChange={(e) =>
              setTitle(
                e.target.value
              )
            }
            required
          />
        </label>

        <label>
          Présentation
          <textarea
            value={messageText}
            onChange={(e) =>
              setMessageText(
                e.target.value
              )
            }
            required
          />
        </label>

        <button className="primary">
          Envoyer la candidature
        </button>

      </form>

      <div className="list">

        {applications.map((item) => (
          <div
            className="list-item"
            key={item.id}
          >
            <strong>
              {item.reference}
            </strong>

            <span>
              {item.title}
            </span>

            <small>
              {item.status}
            </small>
          </div>
        ))}

      </div>

    </div>
  );
}

