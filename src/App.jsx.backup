/* =========================================================
   ADMIN ÉGLISES
========================================================= */

function AdminChurches({
  churches,
  onValidate,
  onReject,
}) {
  return (
    <div>

      <span className="eyebrow">
        ÉGLISES
      </span>

      <h2>
        Validation des églises
      </h2>

      {churches.map((church) => (
        <div
          className="admin-row"
          key={church.id}
        >

          <div>

            <strong>
              {church.name}
            </strong>

            <span>
              {church.city}
              {" · "}
              {church.pastor || "Pasteur non renseigné"}
              {" · "}
              {church.submittedBy}
            </span>

          </div>

          {church.status ===
          "En attente" ? (
            <div>

              <button
                className="green"
                onClick={() =>
                  onValidate(
                    church.id
                  )
                }
              >
                Valider
              </button>

              <button
                className="danger"
                onClick={() =>
                  onReject(
                    church.id
                  )
                }
              >
                Rejeter
              </button>

            </div>
          ) : (
            <span className="status-ok">
              {church.status}
            </span>
          )}

        </div>
      ))}

      {!churches.length && (
        <p className="muted">
          Aucune église soumise.
        </p>
      )}

    </div>
  );
}

