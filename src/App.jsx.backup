                {item.reference}
              </strong>

              <span>
                {item.title}
              </span>

              <small>
                {item.status}
              </small>
            </div>
          )
        )}

      </div>

    </div>
  );
}

/* =========================================================
   RAPPORT
========================================================= */

function ReportForm({
  reports,
  onSubmit,
}) {
  const [title, setTitle] =
    useState("");

  const [text, setText] =
    useState("");

  function submit(event) {
    event.preventDefault();

    if (!title || !text) {
      return;
    }

    onSubmit(title, text);

    setTitle("");
    setText("");
  }

  return (
    <div>

      <span className="eyebrow">
        RAPPORTS
      </span>

      <h2>
        Transmettre un rapport
      </h2>

      <form
        className="simple-form"
        onSubmit={submit}
      >

        <label>
          Titre
          <input
            value={title}
            onChange={(e) =>
              setTitle(
                e.target.value
              )
            }
            required
          />
        </label>

        <label>
          Rapport
          <textarea
            value={text}
            onChange={(e) =>
              setText(
                e.target.value
              )
            }
            required
          />
        </label>

        <button className="primary">
          Transmettre le rapport
        </button>

      </form>

      <div className="list">

        {reports.map((item) => (
          <div
            className="list-item"
            key={item.id}
          >
            <strong>
              {item.reference}
            </strong>

            <span>
              {item.title}
            </span>

            <small>
              {item.status}
            </small>
          </div>
        ))}

      </div>

    </div>
  );
}

/* =========================================================
   BOUTIQUE
========================================================= */

function Shop({
  products,
  cart,
  total,
  onAdd,
  onRemove,
  onQuantity,
  onOrder,
  onLogin,
  connected,
}) {
  return (
    <section className="shop">

      <div className="section-head">

        <div>

          <span className="eyebrow">
            JADCI STORE
          </span>

          <h1>
            Boutique
          </h1>

        </div>

        <div className="cart-summary">

          🛒 {cart.length} article(s)

          <strong>
            {money(total)}
          </strong>

        </div>

      </div>

      <div className="shop-grid">

        <div className="products-grid">

          {products.map((product) => (
            <ProductCard
              key={product.id}
              product={product}
              onAdd={onAdd}
            />
          ))}

        </div>

        <aside className="cart">

          <span className="eyebrow">
            PANIER
          </span>

          <h2>
            Votre panier
          </h2>

          {!cart.length && (
            <p className="muted">
              Votre panier est vide.
            </p>
          )}

          {cart.map((item) => (
            <div
              className="cart-item"
              key={`${item.id}-${item.size}`}
            >

              <div>

                <strong>
                  {item.name}
                </strong>

                <span>
                  {item.quantity}
                  {" × "}
                  {money(item.price)}
                </span>

                {item.size && (
                  <small>
                    Taille : {item.size}
                  </small>
                )}

              </div>

              <div>

                <input
                  type="number"
                  min="1"
                  max={item.stock}
                  value={item.quantity}
                  onChange={(e) =>
                    onQuantity(
                      item.id,
                      item.size,
                      e.target.value
                    )
                  }
                />

                <button
                  onClick={() =>
                    onRemove(
                      item.id,
                      item.size
                    )
                  }
                >
                  Retirer
                </button>

              </div>

            </div>
          ))}

          <hr />

          <strong>
            Total : {money(total)}
          </strong>

          {!connected ? (
            <button
              className="primary full"
              onClick={onLogin}
            >
              Se connecter pour commander
            </button>
          ) : (
            <button
              className="primary full"
              onClick={onOrder}
              disabled={!cart.length}
            >
              Passer la commande
            </button>
          )}

        </aside>

      </div>
    </section>
  );
}

function ProductCard({
  product,
  onAdd,
}) {
  const [size, setSize] =
    useState(
      product.sizes?.length
        ? product.sizes[0]
        : ""
    );

  return (
    <article className="product-card">

      {product.image ? (
        <img
          src={product.image}
          alt={product.name}
        />
      ) : (
        <div className="product-placeholder">
          🛍️
        </div>
      )}

      <span>
        {product.category}
      </span>

      <h3>
        {product.name}
      </h3>

      <p>
        {product.description}
      </p>

      <strong>
        {money(product.price)}
      </strong>

      <small>
        Stock : {product.stock}
      </small>

      {product.sizes?.length > 0 && (
        <label>
          Taille
          <select
            value={size}
            onChange={(e) =>
              setSize(e.target.value)
            }
          >
            {product.sizes.map(
              (item) => (
                <option
                  key={item}
                  value={item}
                >
                  {item}
                </option>
              )
            )}
          </select>
        </label>
      )}

      <button
        className="primary"
        onClick={() =>
          onAdd(product, size)
        }
        disabled={!product.stock}
      >
        {product.stock
          ? "Ajouter au panier"
          : "Rupture de stock"}
      </button>

    </article>
  );
}

/* =========================================================
   ACTUALITÉS
========================================================= */

function NewsPage({
  news,
}) {
  return (
    <section className="news-page">

      <span className="eyebrow">
        ACTUALITÉS
      </span>

      <h1>
        Actualités JADCI
      </h1>

      <div className="news-grid">

        {news
          .filter(
            (item) => item.published !== false
          )
          .map((item) => (
            <article
              className="news-card"
              key={item.id}
            >

              {item.image && (
                <img
                  src={item.image}
                  alt={item.title}
                />
              )}

              <div>

                <small>
                  {item.date}
                </small>

                <h2>
                  {item.title}
                </h2>

                <p>
                  {item.text}
                </p>

                {item.video && (
                  <a
                    href={item.video}
                    target="_blank"
                    rel="noreferrer"
                  >
                    ▶ Voir la vidéo
                  </a>
                )}

                {item.document && (
                  <a
                    href={item.document}
                    target="_blank"
                    rel="noreferrer"
                  >
                    📄 Document
                  </a>
                )}

              </div>

            </article>
          ))}

      </div>

    </section>
  );
}

