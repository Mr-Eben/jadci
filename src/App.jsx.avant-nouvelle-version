    doc.text(`Client : ${compte.nom}`, 10, 27);
    doc.text(`Matricule : ${compte.matricule}`, 10, 33);
    doc.text(`Référence commande : CMD-${commande.id}`, 10, 39);
    doc.text(`Code reçu : ${commande.codeRecu}`, 10, 45);
    doc.text(`Date de paiement : ${commande.datePaiement}`, 10, 51);
    doc.line(10, 56, 138, 56);

