/* =========================
   JADCI - DESIGN INSTITUTIONNEL
========================= */

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-width: 320px;
  background: #ffffff;
  color: #1e293b;
  font-family:
    "Inter",
    "Segoe UI",
    Arial,
    sans-serif;
}

#root {
  width: 100%;
  overflow-x: hidden;
}

button,
input,
textarea,
select {
  font: inherit;
}

button {
  cursor: pointer;
  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    background 0.25s ease;
}

button:hover {
  transform: translateY(-2px);
}

img {
  max-width: 100%;
  height: auto;
}


/* =========================
   COULEURS JADCI
========================= */

:root {
  --violet-jadci: #5b21b6;
  --violet-light: #ede9fe;
  --bleu-roi: #1d4ed8;
  --jaune: #eab308;
  --vert: #16a34a;
  --blanc: #ffffff;
  --gris: #64748b;
  --fond: #f8fafc;
}


/* =========================
   HEADER / NAVIGATION
========================= */

.headerInner {
  background: rgba(255,255,255,0.95);
  border-bottom: 1px solid #e2e8f0;
  padding: 18px 35px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 25px;
}


.brandTitle {
  color: var(--violet-jadci);
  font-weight: 900;
  letter-spacing: 1px;
}


.brandSubtitle {
  color: var(--gris);
}


.nav {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}


.navButton {
  border: none;
  background: transparent;
  color: #334155;
  font-weight: 800;
  padding: 12px 16px;
  border-radius: 12px;
}


.navButton:hover {
  background: var(--violet-light);
  color: var(--violet-jadci);
}


.navButton.active {
  background: var(--bleu-roi);
  color: white;
}
/* =========================
   MAIN
========================= */

.main {
  background: linear-gradient(
    180deg,
    #ffffff 0%,
    #f8f7ff 100%
  );
  padding: 70px 40px;
}


/* =========================
   HERO ACCUEIL
========================= */

.hero {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 50px;
  max-width: 1200px;
  margin: auto;
}


.heroTitle {
  font-size: 60px;
  font-weight: 900;
  line-height: 1.05;
  color: var(--violet-jadci);
}


.heroText {
  font-size: 20px;
  line-height: 1.7;
  color: #475569;
  max-width: 600px;
}


.heroActions {
  display: flex;
  gap: 15px;
  margin-top: 30px;
}


.heroActions button {
  padding: 15px 28px;
  border-radius: 14px;
  border: none;
  font-weight: 800;
}


.primaryButton {
  background: var(--bleu-roi);
  color: white;
}


.secondaryButton {
  background: var(--violet-light);
  color: var(--violet-jadci);
}


/* =========================
   CARTES
========================= */

.cards {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 25px;
  margin-top: 60px;
}


.card {
  background: white;
  border-radius: 22px;
  padding: 28px;
  box-shadow:
    0 15px 35px rgba(15, 23, 42, 0.08);
  border: 1px solid #e2e8f0;
  transition: transform .3s ease, box-shadow .3s ease;
}


.card:hover {
  transform: translateY(-8px);
  box-shadow:
    0 20px 45px rgba(91,33,182,.15);
}


.cardTitle {
  color: var(--violet-jadci);
  font-weight: 900;
  font-size: 20px;
}


.cardText {
  color: #64748b;
  line-height: 1.6;
}


/* =========================
   BANDEAU ANNONCES
========================= */

.announcement {
  display:flex;
  align-items:center;
  background:white;
  border-radius:18px;
  overflow:hidden;
  box-shadow:
    0 10px 30px rgba(0,0,0,.08);
  margin:30px auto;
}


.announcementTitle {
  background:var(--bleu-roi);
  color:white;
  font-weight:900;
  padding:18px 25px;
}


.announcementText {
  padding:18px 25px;
  color:#334155;
}


/* =========================
   BOUTIQUE
========================= */

.product-card {
  background:white;
  border-radius:20px;
  padding:20px;
  border:1px solid #e2e8f0;
}


.product-image {
  width:100%;
  border-radius:15px;
}


.price {
  color:var(--vert);
  font-weight:900;
  font-size:22px;
}


/* =========================
   UTILISATEURS
========================= */

.user-grid {
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:25px;
}


.profile-box {
  background:white;
  padding:30px;
  border-radius:22px;
  box-shadow:
  0 15px 35px rgba(0,0,0,.08);
}


/* =========================
   TITRES DE SECTION
========================= */

.sectionTitle {
  color:var(--violet-jadci);
  font-size:38px;
  font-weight:900;
}


.sectionText {
  color:#475569;
  font-size:18px;
  line-height:1.7;
}
/* =========================
   RESPONSIVE TABLETTE
========================= */

@media (max-width: 1100px) {

  .headerInner {
    flex-direction: column;
    text-align: center;
  }

  .nav {
    justify-content: center;
  }

  .hero {
    grid-template-columns: 1fr;
    text-align: center;
  }

  .heroText {
    margin-left: auto;
    margin-right: auto;
  }

  .heroActions {
    justify-content: center;
  }

  .cards {
    grid-template-columns: repeat(2, 1fr);
  }

}


/* =========================
   RESPONSIVE MOBILE
========================= */

@media (max-width: 700px) {


  .headerInner {
    padding: 15px;
  }


  .brandTitle {
    font-size: 22px;
  }


  .nav {
    width:100%;
    flex-direction:column;
    gap:8px;
  }


  .navButton {
    width:100%;
    padding:12px;
  }


  .main {
    padding:40px 18px;
  }


  .heroTitle {
    font-size:40px;
  }


  .heroText {
    font-size:16px;
  }


  .heroActions {
    flex-direction:column;
  }


  .heroActions button {
    width:100%;
  }


  .cards {
    grid-template-columns:1fr;
    gap:18px;
  }


  .card {
    padding:22px;
  }


  .announcement {
    flex-direction:column;
  }


  .announcementTitle,
  .announcementText {
    width:100%;
    text-align:center;
  }


  .user-grid {
    grid-template-columns:1fr;
  }


  .sectionTitle {
    font-size:30px;
  }


  .profile-box {
    padding:20px;
  }

}


/* =========================
   PETITS TELEPHONES
========================= */

@media (max-width:430px) {


  .heroTitle {
    font-size:34px;
  }


  .sectionTitle {
    font-size:26px;
  }


  .brandTitle {
    font-size:20px;
  }


  .card {
    border-radius:16px;
  }

}


/* =========================
   ANIMATIONS MODERNES
========================= */

.card,
.profile-box,
.product-card,
.hero {
  animation: apparition .6s ease;
}


@keyframes apparition {

  from {
    opacity:0;
    transform:translateY(20px);
  }

  to {
    opacity:1;
    transform:translateY(0);
  }

}


/* =========================
   UTILITAIRES
========================= */

.text-center {
  text-align:center;
}


.hidden {
  display:none;
}


.w-full {
  width:100%;
}